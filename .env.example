# Which transport `lib/apiClient.js` uses for every service call.
#   mock  - in-process handlers over data/mock*.js (no network, no env needed)
#   dcms  - real HTTP against NEXT_PUBLIC_DCMS_API_URL
#
# Defaults to "mock" when unset.
NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL of the DCMS. Required when NEXT_PUBLIC_DATA_SOURCE=dcms.
# Trailing slashes are stripped; paths are appended by lib/apiClient.
# NEXT_PUBLIC_DCMS_API_URL=https://api.example-dcms.com/v1

# Optional static key, sent as `Authorization: Bearer <key>` for public
# catalogue reads. A signed-in shopper's own token always takes precedence.
# NEXT_PUBLIC_DCMS_API_KEY=

# NOTE: NEXT_PUBLIC_* values are inlined at build time. Changing
# NEXT_PUBLIC_DATA_SOURCE requires a rebuild, not just a dev-server restart.
